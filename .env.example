# Copiar a .env (raíz) y ajustar. Nunca subir .env al repositorio.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=shopify_erp
POSTGRES_PORT=5433
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5433/shopify_erp

# --- API (NestJS) ---
API_PORT=8080
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# Registro público de empresas (false = privado: el superadmin las crea con npm run tenant:create)
ALLOW_SIGNUP=false

# --- Shopify App ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,write_orders,read_customers,read_fulfillments,write_fulfillments,read_locations
SHOPIFY_APP_URL=http://localhost:8080

# --- Seguridad ---
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# --- Login con Google (OpenID Connect) ---
# Crear en Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe registrarse EXACTA en Google como "URI de redireccionamiento autorizado"
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Opcional: restringir a un dominio de Google Workspace (ej: miempresa.com). Vacío = cualquier cuenta
GOOGLE_ALLOWED_DOMAIN=

# --- Web (Next.js) ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Shopify ERP
API_INTERNAL_URL=http://localhost:8080
