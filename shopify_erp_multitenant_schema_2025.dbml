// ============================================================
// Shopify Data Model — ERP Multitenant Relational Schema 2025 (ENTERPRISE / PROD-READY)
// Arquitectura desacoplada: ERP Omnicanal con Conector Shopify Admin GraphQL API (2025-10+)
// v2: alineado con el modelo de la Admin GraphQL API (sin campos legacy de REST)
// ============================================================
// PATRONES ARQUITECTÓNICOS APLICADOS:
// 1. Fuente de Verdad Propia (Patrón Anticorrupción) + Multi-tienda:
//    - Cada entidad tiene su PK interna autoincremental (id bigint [pk]).
//    - CATÁLOGO MAESTRO (products, options, variants, media, inventory_items, locations):
//      no guarda IDs de Shopify. Un mismo producto ERP puede publicarse en N tiendas.
//        * shopify_resource_links -> identidad: (shop_id, shopify_gid) <-> erp_id por tienda.
//        * product_shop_listings / variant_shop_listings -> intención comercial por tienda
//          (publicado, estado, precio, overrides de título/SEO).
//        * shop_locations -> bodega ERP <-> Location de cada tienda + regla de stock.
//    - DATOS TRANSACCIONALES POR TIENDA (customers, orders y sus hijos, fulfillments,
//      collections, discounts, metafields): nacen en una tienda, guardan shop_id + shopify_gid inline.
//    - Los GIDs de Shopify son únicos POR TIENDA: índices (shop_id, shopify_gid).
//    - Integridad cross-tenant: en producción, usar FKs compuestas (tenant_id, x_id) -> (tenant_id, id).
// 2. Seguridad de Credenciales:
//    - shops.encrypted_access_token (cifrado AES-256-GCM en la aplicación).
//    - shops.encryption_key_version (soporte para rotación de llaves KMS/Vault).
//    - shops.granted_scopes (control estricto de permisos OAuth concedidos).
// 3. Control de Concurrencia y Sincronización Segura:
//    - shopify_updated_at en entidades para comparar marcas de tiempo y evitar que un
//      webhook tardío sobrescriba una edición local más reciente en el ERP.
//    - version (Optimistic Concurrency Control) para escrituras concurrentes.
// 4. Integridad Cross-Tenant & RLS de Alto Rendimiento:
//    - tenant_id desnormalizado en TODAS las tablas hijas, con índices compuestos
//      (tenant_id, ...) para consultas RLS directas sin JOINs pesados.
// 5. Dinero según GraphQL (MoneyBag):
//    - Columnas sin sufijo = shopMoney (moneda de la tienda, orders.currency_code).
//    - Columnas *_presentment = presentmentMoney (moneda del comprador, orders.presentment_currency_code).
//    - decimal(18,4) para soportar monedas de 0 y 3 decimales (CLP, JPY, KWD, BHD).
// 6. Soporte para Shopify Bulk Operations & GDPR:
//    - shopify_bulk_operations (manejo asíncrono de importaciones masivas en JSONL).
//    - shopify_compliance_requests (webhooks obligatorios: customers/redact, customers/data_request, shop/redact).
// 7. Trazabilidad Financiera y Soft Delete:
//    - tax_lines y discount_allocations a nivel de línea (no solo de orden).
//    - deleted_at en entidades maestras para procesar webhooks */delete sin destruir datos contables.
// 8. Tipos PostgreSQL: timestamptz (cada tienda tiene su zona horaria), jsonb para JSON, text[] para tags.
// ============================================================

// ------------------------------------------------------------
// 1. USUARIOS DEL SAAS, TENANTS Y CONTROL DE ACCESO (RBAC)
// ------------------------------------------------------------

Table tenants {
  id              bigint       [pk, increment, note: "ID interno del cliente del ERP (Tenant / Empresa SaaS)"]
  company_name    varchar(255) [note: "Nombre comercial de la empresa cliente"]
  billing_email   varchar(255)
  status          varchar(20)  [default: "active", note: "active | suspended | trialing | cancelled"]
  plan_tier       varchar(50)  [default: "pro", note: "starter | pro | enterprise"]
  reporting_currency varchar(3) [default: "USD", note: "Moneda para reportes consolidados multi-tienda"]
  created_at      timestamptz
  updated_at      timestamptz

  note: "Tabla maestra de inquilinos (Tenants / Organizaciones) del ERP SaaS."
}

Table users {
  id              bigint       [pk, increment, note: "ID de usuario del SaaS"]
  email           varchar(255) [unique, note: "Email de inicio de sesión"]
  password_hash   varchar(255) [null, note: "Hash argon2id. NULL si el usuario solo entra con Google (user_identities)"]
  email_verified_at timestamptz [null]
  failed_login_attempts int    [default: 0, note: "Bloqueo temporal ante fuerza bruta"]
  locked_until    timestamptz  [null]
  first_name      varchar(100)
  last_name       varchar(100)
  is_superuser    boolean      [default: false, note: "Admin global de la plataforma SaaS"]
  status          varchar(20)  [default: "active", note: "active | invited | suspended"]
  last_login_at   timestamptz  [null]
  created_at      timestamptz
  updated_at      timestamptz

  note: "Usuarios humanos que inician sesión y operan el ERP. Un mismo login puede pertenecer a varios tenants."
}

Table roles {
  id              bigint       [pk, increment]
  tenant_id       bigint       [null, ref: > tenants.id, note: "NULL para roles globales por defecto; tenant_id para roles custom del cliente"]
  name            varchar(50)  [note: "OWNER | ADMIN | WAREHOUSE_MANAGER | ACCOUNTANT | VIEWER | CUSTOM"]
  description     varchar(255) [null]
  permissions     jsonb        [note: "Array de permisos: ['orders:read', 'orders:write', 'inventory:manage', ...]"]
  created_at      timestamptz
  updated_at      timestamptz

  indexes {
    (tenant_id, name) [unique]
    (id, tenant_id) [unique, note: "Garantiza integridad relacional cross-tenant"]
  }
  note: "Roles y matriz de permisos para el control de acceso basado en roles (RBAC)."
}

Table tenant_users {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id, note: "Tenant al que pertenece la membresía"]
  user_id         bigint       [ref: > users.id, note: "Usuario miembro"]
  role_id         bigint       [ref: > roles.id, note: "Rol asignado dentro del tenant (FK compuesta (role_id, tenant_id) -> roles(id, tenant_id) para roles custom)"]
  all_shops_access boolean     [default: true, note: "true = ve todas las tiendas del tenant; false = solo las de tenant_user_shops"]
  status          varchar(20)  [default: "active", note: "active | invited | revoked"]
  created_at      timestamptz
  updated_at      timestamptz

  indexes {
    (tenant_id, user_id) [unique]
    (tenant_id, role_id)
  }
  note: "Membresía M:N: un usuario puede operar en uno o varios tenants con roles específicos."
}

Table tenant_user_shops {
  tenant_id       bigint [ref: > tenants.id, note: "Desnormalizado para RLS"]
  tenant_user_id  bigint [ref: > tenant_users.id]
  shop_id         bigint [ref: > shops.id]
  role_id         bigint [null, ref: > roles.id, note: "Rol específico en esta tienda (NULL = hereda el rol de tenant_users)"]
  created_at      timestamptz

  indexes {
    (tenant_user_id, shop_id) [pk]
    (tenant_id, shop_id)
  }
  note: "Restricción opcional de acceso por tienda. Solo aplica cuando tenant_users.all_shops_access = false."
}

Table user_sessions {
  id              uuid         [pk, note: "ID de sesión (se guarda HASHEADO en token_hash; la cookie lleva el token)"]
  user_id         bigint       [ref: > users.id]
  token_hash      varchar(64)  [unique, note: "SHA-256 del token de la cookie httpOnly. Nunca el token en claro"]
  active_tenant_id bigint      [null, ref: > tenants.id, note: "Último tenant seleccionado"]
  ip_address      varchar(45)  [null]
  user_agent      varchar(500) [null]
  created_at      timestamptz
  last_seen_at    timestamptz
  expires_at      timestamptz
  revoked_at      timestamptz  [null, note: "Logout, cambio de contraseña o revocación por admin"]
  auth_method     varchar(20)  [note: "PASSWORD | GOOGLE"]

  indexes {
    (user_id, revoked_at)
    (expires_at)
  }
  note: "Sesiones en base de datos (revocables al instante), creadas tras login con contraseña o con Google."
}

Table user_tokens {
  id              bigint       [pk, increment]
  user_id         bigint       [ref: > users.id]
  type            varchar(30)  [note: "EMAIL_VERIFICATION | PASSWORD_RESET"]
  token_hash      varchar(64)  [unique, note: "SHA-256 del token enviado por email"]
  expires_at      timestamptz
  used_at         timestamptz  [null, note: "Un solo uso"]
  created_at      timestamptz

  indexes {
    (user_id, type)
  }
  note: "Tokens de un solo uso: verificar email y recuperar contraseña."
}

Table tenant_invitations {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id]
  email           varchar(255)
  role_id         bigint       [ref: > roles.id]
  shop_ids        "bigint[]"   [null, note: "NULL = acceso a todas las tiendas"]
  token_hash      varchar(64)  [unique]
  invited_by_user_id bigint    [ref: > users.id]
  status          varchar(20)  [default: "pending", note: "pending | accepted | revoked | expired"]
  expires_at      timestamptz
  accepted_at     timestamptz  [null]
  created_at      timestamptz

  indexes {
    (tenant_id, email, status)
  }
  note: "Invitaciones de empleados a un tenant (la administración es privada: no hay registro público de empleados)."
}

Table user_identities {
  id                bigint       [pk, increment]
  user_id           bigint       [ref: > users.id]
  provider          varchar(30)  [note: "GOOGLE (extensible: MICROSOFT, ...)"]
  provider_user_id  varchar(255) [note: "Claim 'sub' del ID token: identificador ESTABLE (el email puede cambiar)"]
  email             varchar(255) [null, note: "Email informado por el proveedor al vincular"]
  email_verified    boolean      [default: false, note: "Claim 'email_verified' de Google"]
  hosted_domain     varchar(255) [null, note: "Claim 'hd' (Google Workspace), útil para restringir por dominio"]
  last_login_at     timestamptz  [null]
  created_at        timestamptz

  indexes {
    (provider, provider_user_id) [unique]
    (user_id, provider) [unique, note: "Una cuenta Google por usuario"]
  }
  note: "Cuentas externas vinculadas a un usuario (Login con Google vía OpenID Connect). Un usuario puede entrar con contraseña, con Google o con ambos."
}

Table oidc_login_states {
  state_hash        varchar(64)  [pk, note: "SHA-256 del secreto guardado en cookie httpOnly temporal; se envía como 'state'"]
  provider          varchar(30)  [note: "GOOGLE"]
  code_verifier     varchar(128) [note: "PKCE: se envía al canjear el code"]
  nonce             varchar(128) [note: "Debe coincidir con el claim 'nonce' del ID token (anti-replay)"]
  redirect_to       varchar(500) [null, note: "Ruta RELATIVA a la que volver tras el login (evita open redirect)"]
  link_user_id      bigint       [null, ref: > users.id, note: "Si un usuario logueado está vinculando su cuenta Google"]
  invitation_id     bigint       [null, ref: > tenant_invitations.id, note: "Si el login viene de aceptar una invitación"]
  expires_at        timestamptz  [note: "~10 minutos"]
  created_at        timestamptz

  indexes {
    (expires_at)
  }
  note: "Transacción temporal del login con Google (state + PKCE + nonce). Se BORRA al usarse (un solo uso)."
}

// ------------------------------------------------------------
// 2. CONEXIÓN SHOPIFY, CREDENCIALES Y OPERACIONES ASÍNCRONAS
// ------------------------------------------------------------

Table shops {
  id                    bigint       [pk, increment, note: "ID interno de la tienda en el ERP"]
  tenant_id             bigint       [ref: > tenants.id, note: "Tenant dueño de esta tienda"]
  shopify_gid           varchar(255) [unique, note: "Shop GID: gid://shopify/Shop/123456"]
  shopify_legacy_id     bigint       [null, unique, note: "ID numérico legacy de la tienda"]
  name                  varchar(255)
  email                 varchar(255) [note: "Shop.email (notificaciones de la tienda)"]
  contact_email         varchar(255) [null, note: "Shop.contactEmail (visible a clientes)"]
  primary_domain        varchar(255) [note: "Shop.primaryDomain.host"]
  myshopify_domain      varchar(255) [unique]
  currency_code         varchar(3)   [note: "Shop.currencyCode (moneda base = shopMoney)"]
  enabled_presentment_currencies "text[]" [null, note: "Shop.currencySettings / Markets"]
  money_format          varchar(50)
  iana_timezone         varchar(100) [note: "Shop.ianaTimezone, ej: America/Santiago"]
  plan_display_name     varchar(100) [note: "Shop.plan.publicDisplayName"]
  country_code          varchar(2)   [note: "Shop.billingAddress.countryCodeV2"]
  taxes_included        boolean      [default: false, note: "Shop.taxesIncluded"]
  primary_location_id   bigint       [null, ref: > shop_locations.id, note: "Location principal de la tienda"]
  api_version           varchar(10)  [note: "Versión de la Admin API usada para esta tienda, ej: 2025-10"]
  encrypted_access_token text        [note: "Token OAuth offline cifrado con AES-256-GCM. NUNCA en texto plano"]
  encrypted_refresh_token text       [null, note: "Solo si se usan tokens offline con expiración"]
  token_expires_at      timestamptz  [null]
  encryption_key_version int         [default: 1, note: "Versión de la llave criptográfica (KMS/Vault) para rotación segura"]
  granted_scopes        "text[]"     [note: "Scopes OAuth aprobados, ej: {read_products,write_orders}"]
  status                varchar(20)  [default: "installed", note: "installed | uninstalled | frozen | paused"]
  installed_at          timestamptz
  uninstalled_at        timestamptz  [null, note: "Webhook app/uninstalled. shop/redact llega ~48h después"]
  created_at            timestamptz
  updated_at            timestamptz

  indexes {
    (tenant_id, status)
  }
  note: "Tiendas de Shopify conectadas al ERP. Cada tienda pertenece a un único Tenant."
}

Table shopify_webhook_events {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id]
  shop_id         bigint       [ref: > shops.id]
  webhook_id      varchar(255) [unique, note: "X-Shopify-Webhook-Id (idempotencia ante reintentos)"]
  event_id        varchar(255) [null, note: "X-Shopify-Event-Id (mismo evento entregado a varias suscripciones)"]
  topic           varchar(100) [note: "orders/create | products/update | inventory_levels/update | app/uninstalled | etc."]
  api_version     varchar(10)  [note: "X-Shopify-API-Version"]
  triggered_at    timestamptz  [null, note: "X-Shopify-Triggered-At"]
  status          varchar(20)  [default: "pending", note: "pending | processed | failed | ignored"]
  payload         jsonb        [note: "JSON crudo enviado por Shopify"]
  error_message   text         [null]
  attempts        int          [default: 0]
  processed_at    timestamptz  [null]
  created_at      timestamptz

  indexes {
    (tenant_id, shop_id, topic, status)
    (shop_id, event_id)
    (status, created_at)
  }
  note: "Cola y bitácora de webhooks para procesamiento asíncrono e idempotente. Particionar por mes (created_at)."
}

Table shopify_bulk_operations {
  id                  bigint       [pk, increment]
  tenant_id           bigint       [ref: > tenants.id]
  shop_id             bigint       [ref: > shops.id]
  bulk_operation_gid  varchar(255) [note: "gid://shopify/BulkOperation/123456"]
  type                varchar(20)  [note: "QUERY | MUTATION"]
  status              varchar(20)  [note: "CREATED | RUNNING | COMPLETED | CANCELING | CANCELED | FAILED | EXPIRED"]
  query               text         [null, note: "Query/mutation GraphQL enviada"]
  resource_type       varchar(40)  [null, note: "PRODUCT | ORDER | CUSTOMER | INVENTORY | ... (uso interno)"]
  error_code          varchar(50)  [null, note: "ACCESS_DENIED | INTERNAL_SERVER_ERROR | TIMEOUT"]
  object_count        bigint       [default: 0]
  root_object_count   bigint       [default: 0]
  file_size           bigint       [null, note: "Tamaño en bytes del archivo resultante"]
  result_url          text         [null, note: "URL firmada de Shopify al JSONL (expira, descargar pronto)"]
  partial_data_url    text         [null]
  created_at          timestamptz
  completed_at        timestamptz  [null]

  indexes {
    (shop_id, bulk_operation_gid) [unique]
    (tenant_id, shop_id, status)
  }
  note: "Tracking de Bulk Operations API para catálogos y órdenes históricas."
}

Table shopify_compliance_requests {
  id                  bigint       [pk, increment]
  tenant_id           bigint       [ref: > tenants.id]
  shop_id             bigint       [null, ref: > shops.id]
  topic               varchar(50)  [note: "customers/redact | customers/data_request | shop/redact"]
  webhook_id          varchar(255) [null, unique]
  data_request_id     bigint       [null, note: "data_request.id del payload (solo customers/data_request)"]
  shop_domain         varchar(255)
  shopify_customer_id bigint       [null, note: "customer.id del payload"]
  customer_email      varchar(255) [null]
  customer_phone      varchar(50)  [null]
  orders_to_redact    "bigint[]"   [null, note: "IDs de órdenes a anonimizar"]
  orders_requested    "bigint[]"   [null]
  status              varchar(20)  [default: "pending", note: "pending | processing | completed | failed"]
  processed_at        timestamptz  [null]
  created_at          timestamptz

  indexes {
    (tenant_id, topic, status)
  }
  note: "Registro obligatorio de solicitudes de privacidad (GDPR/CCPA) exigidas por Shopify."
}

// ------------------------------------------------------------
// 3. PRODUCTOS Y CATÁLOGO (OMNICANAL)
// ------------------------------------------------------------

Table products {
  id                  bigint       [pk, increment, note: "ID interno propio del ERP (Fuente de verdad)"]
  tenant_id           bigint       [ref: > tenants.id, note: "Tenant dueño del producto"]
  origin_shop_id      bigint       [null, ref: > shops.id, note: "Tienda desde la que se importó (informativo). NULL si se creó en el ERP"]
  title               varchar(255) [note: "Título maestro (product_shop_listings puede sobrescribirlo por tienda)"]
  description_html    text         [null, note: "Product.descriptionHtml maestro"]
  vendor              varchar(255) [null]
  product_type        varchar(255) [null, note: "Tipo libre del comercio"]
  category_gid        varchar(255) [null, note: "Product.category: gid://shopify/TaxonomyCategory/... (Shopify Standard Product Taxonomy)"]
  handle              varchar(255) [note: "Slug maestro (único por tenant; overridable por tienda)"]
  status              varchar(20)  [note: "Ciclo de vida ERP: ACTIVE | DRAFT | ARCHIVED. El estado en cada tienda vive en product_shop_listings"]
  tags                "text[]"     [null]
  seo_title           varchar(255) [null, note: "Product.seo.title"]
  seo_description     text         [null, note: "Product.seo.description"]
  template_suffix     varchar(100) [null]
  is_gift_card        boolean      [default: false, note: "Product.isGiftCard"]
  requires_selling_plan boolean    [default: false, note: "Solo vendible por suscripción"]
  has_variants_that_require_components boolean [default: false, note: "Contiene variantes bundle"]
  combined_listing_role varchar(10) [null, note: "PARENT | CHILD (Combined Listings, Shopify Plus)"]
  version             int          [default: 1, note: "Optimistic concurrency lock (se compara con shopify_resource_links.erp_version_synced)"]
  deleted_at          timestamptz  [null, note: "Soft delete"]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (tenant_id, handle) [unique]
    (tenant_id, status)
    (tenant_id, vendor)
    (tenant_id, deleted_at)
  }
  note: "Catálogo MAESTRO del ERP (sin IDs de Shopify). Publicación por tienda: product_shop_listings + shopify_resource_links."
}

Table product_options {
  id              bigint       [pk, increment, note: "ID interno del ERP"]
  tenant_id       bigint       [ref: > tenants.id, note: "Desnormalizado para RLS"]
  product_id      bigint       [ref: > products.id]
  name            varchar(255) [note: "Ej: Color, Talla, Material (máx. 3 opciones por producto). GID por tienda en shopify_resource_links (PRODUCT_OPTION)"]
  position        int          [note: "Orden de display (1, 2, 3)"]
  linked_metafield_namespace varchar(255) [null, note: "ProductOption.linkedMetafield (opciones ligadas a metafields de categoría)"]
  linked_metafield_key       varchar(255) [null]

  indexes {
    (product_id, position) [unique]
    (tenant_id, product_id)
  }
  note: "Opciones que definen las variantes del producto (modelo de producto 2024-04+)."
}

Table product_option_values {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id, note: "Desnormalizado para RLS"]
  option_id       bigint       [ref: > product_options.id]
  product_id      bigint       [ref: > products.id]
  name            varchar(255) [note: "Ej: Rojo, XL, Algodón. GID por tienda en shopify_resource_links (PRODUCT_OPTION_VALUE)"]
  position        int
  has_variants    boolean      [default: true, note: "ProductOptionValue.hasVariants"]
  swatch_color    varchar(20)  [null, note: "ProductOptionValue.swatch.color (hex)"]
  swatch_image_media_id bigint [null, ref: > media.id, note: "ProductOptionValue.swatch.image"]
  linked_metafield_value text  [null, note: "Valor del metaobject ligado (si la opción usa linked metafield)"]

  indexes {
    (option_id, name) [unique]
    (tenant_id, product_id)
  }
  note: "Valores por opción. En GraphQL existen aunque no tengan variantes (hasVariants=false)."
}

Table product_variants {
  id                  bigint        [pk, increment, note: "ID interno del ERP (SKU comprable)"]
  tenant_id           bigint        [ref: > tenants.id, note: "Tenant dueño de la variante"]
  product_id          bigint        [ref: > products.id]
  title              varchar(255)  [note: "Auto-generado: 'Rojo / XL'. 'Default Title' si no hay opciones"]
  display_name        varchar(255)  [null, note: "ProductVariant.displayName (producto + variante)"]
  sku                 varchar(255)  [null, note: "Lectura: ProductVariant.sku. Escritura: inventoryItem.sku en productVariantsBulk*"]
  barcode             varchar(255)  [null]
  base_price          decimal(18,4) [null, note: "Precio de lista maestro. El precio real por tienda/moneda vive en variant_shop_listings"]
  base_price_currency varchar(3)    [null]
  position            int
  taxable             boolean       [default: true]
  inventory_item_id   bigint        [unique, ref: - inventory_items.id, note: "1:1 estricto con InventoryItem"]
  requires_components boolean       [default: false, note: "Variante tipo bundle (ver product_variant_components)"]
  version             int           [default: 1]
  deleted_at          timestamptz   [null]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (tenant_id, product_id)
    (tenant_id, sku)
    (tenant_id, barcode)
    (tenant_id, deleted_at)
  }
  note: "SKU comprable (hasta 2048 variantes por producto). Peso y datos físicos viven en inventory_items."
}

Table variant_option_values {
  tenant_id         bigint  [ref: > tenants.id, note: "Desnormalizado para RLS"]
  variant_id        bigint  [ref: > product_variants.id]
  option_value_id   bigint  [ref: > product_option_values.id]

  indexes {
    (variant_id, option_value_id) [pk]
  }
  note: "ProductVariant.selectedOptions: variante <-> valores de opción (Rojo + XL)."
}

Table product_variant_components {
  tenant_id             bigint [ref: > tenants.id, note: "Desnormalizado para RLS"]
  parent_variant_id     bigint [ref: > product_variants.id, note: "Variante bundle (requires_components = true)"]
  component_variant_id  bigint [ref: > product_variants.id, note: "Variante que forma parte del bundle"]
  quantity             int    [default: 1, note: "Unidades del componente por bundle"]

  indexes {
    (parent_variant_id, component_variant_id) [pk]
    (tenant_id, component_variant_id)
  }
  note: "ProductVariant.productVariantComponents. Reemplaza a inventory_item_variants: en Shopify el bundle es variante->variantes."
}

// ------------------------------------------------------------
// 4. MEDIA (archivos compartibles entre productos y variantes)
// ------------------------------------------------------------

Table media {
  id                bigint       [pk, increment, note: "ID interno del archivo multimedia"]
  tenant_id         bigint       [ref: > tenants.id]
  media_content_type varchar(20) [note: "IMAGE | VIDEO | EXTERNAL_VIDEO | MODEL_3D"]
  storage_url       varchar(1000) [note: "Copia maestra en el storage del ERP (S3/GCS), desde donde se sube a cada tienda"]
  preview_url       varchar(1000) [null]
  alt               varchar(512) [null]
  width             int          [null]
  height            int          [null]
  file_size         bigint       [null]
  checksum_sha256   varchar(64)  [null, note: "Evita subir duplicados"]
  created_at        timestamptz
  updated_at        timestamptz

  indexes {
    (tenant_id, checksum_sha256)
  }
  note: "Archivo maestro. En cada tienda es un MediaImage/Video/Model3d distinto: GID, URL de Shopify y estado (UPLOADED|PROCESSING|READY|FAILED) en shopify_resource_links (MEDIA)."
}

Table product_media {
  tenant_id     bigint [ref: > tenants.id]
  product_id    bigint [ref: > products.id]
  media_id      bigint [ref: > media.id]
  position      int    [note: "1 = media principal (Product.featuredMedia)"]

  indexes {
    (product_id, media_id) [pk]
    (tenant_id, media_id)
  }
  note: "Product.media. Reemplaza a la tabla legacy product_images (Product.images está obsoleto)."
}

Table variant_media {
  tenant_id     bigint [ref: > tenants.id]
  variant_id    bigint [ref: > product_variants.id]
  media_id      bigint [ref: > media.id]
  position      int

  indexes {
    (variant_id, media_id) [pk]
  }
  note: "ProductVariant.media (reemplaza al obsoleto ProductVariant.image)."
}

// ------------------------------------------------------------
// 5. INVENTARIO MULTITENANT Y UBICACIONES
// ------------------------------------------------------------

Table inventory_items {
  id                        bigint        [pk, increment, note: "ID interno del ítem de inventario"]
  tenant_id                 bigint        [ref: > tenants.id, note: "Tenant dueño del inventario físico"]
  sku                      varchar(255)  [null]
  tracked                   boolean       [default: true, note: "Si se trackea el stock"]
  requires_shipping         boolean       [default: true]
  unit_cost                 decimal(18,4) [null, note: "InventoryItem.unitCost.amount"]
  unit_cost_currency        varchar(3)    [null, note: "InventoryItem.unitCost.currencyCode"]
  country_code_of_origin    varchar(2)    [null]
  province_code_of_origin   varchar(10)   [null]
  harmonized_system_code    varchar(20)   [null]
  country_harmonized_system_codes jsonb   [null, note: "[{countryCode, harmonizedSystemCode}]"]
  weight_value              decimal(12,4) [null, note: "InventoryItem.measurement.weight.value"]
  weight_unit               varchar(10)   [null, note: "GRAMS | KILOGRAMS | OUNCES | POUNDS"]
  version                   int           [default: 1]
  created_at                timestamptz
  updated_at                timestamptz

  indexes {
    (tenant_id, sku)
  }
  note: "Ítem de inventario MAESTRO (físico, costo, aduana, peso). En cada tienda existe un InventoryItem distinto: GID en shopify_resource_links (INVENTORY_ITEM)."
}

Table locations {
  id              bigint       [pk, increment, note: "ID interno de la ubicación/bodega"]
  tenant_id       bigint       [ref: > tenants.id, note: "Tenant dueño de la ubicación"]
  code            varchar(50)  [note: "Código interno de bodega, ej: BOD-STGO-01"]
  type            varchar(20)  [default: "warehouse", note: "warehouse | retail_store | 3pl | virtual"]
  name            varchar(255)
  address1        varchar(255) [null]
  address2        varchar(255) [null]
  city            varchar(100) [null]
  province        varchar(100) [null]
  province_code   varchar(10)  [null]
  country_code    varchar(2)   [null]
  zip             varchar(20)  [null]
  phone           varchar(50)  [null]
  is_active       boolean      [default: true]
  deleted_at      timestamptz  [null]
  created_at      timestamptz
  updated_at      timestamptz

  indexes {
    (tenant_id, code) [unique]
    (tenant_id, deleted_at)
  }
  note: "Ubicación física MAESTRA del ERP. Una bodega puede abastecer a varias tiendas (ver shop_locations)."
}

Table shop_locations {
  id                    bigint       [pk, increment]
  tenant_id             bigint       [ref: > tenants.id]
  shop_id               bigint       [ref: > shops.id]
  location_id           bigint       [ref: > locations.id, note: "Bodega ERP"]
  shopify_gid           varchar(255) [note: "gid://shopify/Location/... en ESA tienda"]
  shopify_legacy_id     bigint       [null]
  shopify_name          varchar(255) [null, note: "Nombre de la Location en Shopify"]
  is_active             boolean      [default: true, note: "Location.isActive"]
  fulfills_online_orders boolean     [default: false]
  ships_inventory       boolean      [default: true, note: "Location.shipsInventory"]
  has_active_inventory  boolean      [default: false]
  fulfillment_service_handle varchar(100) [null, note: "Si es una Location de fulfillment service (3PL)"]
  local_pickup_enabled  boolean      [default: false, note: "Location.localPickupSettingsV2 != null"]

  // --- Regla de publicación de stock ERP -> Shopify ---
  stock_sync_mode       varchar(20)  [default: "MIRROR", note: "MIRROR (100% del available) | PERCENTAGE | BUFFER | MANUAL | NONE (no se sincroniza)"]
  stock_percentage      decimal(5,2) [null, note: "Solo PERCENTAGE: % del available ERP que se publica en esta tienda"]
  stock_buffer          int          [null, note: "Solo BUFFER: unidades que se restan antes de publicar"]
  shopify_updated_at    timestamptz  [null]
  deactivated_at        timestamptz  [null]
  created_at            timestamptz
  updated_at            timestamptz

  indexes {
    (shop_id, shopify_gid) [unique]
    (shop_id, location_id) [unique, note: "Una bodega ERP = una Location por tienda"]
    (tenant_id, location_id)
  }
  note: "Mapeo bodega ERP <-> Location de cada tienda Shopify, con la regla de cuánto stock se publica. Evita sobreventa cuando varias tiendas venden de la misma bodega."
}

Table inventory_levels {
  tenant_id           bigint [ref: > tenants.id, note: "Desnormalizado para RLS"]
  inventory_item_id   bigint [ref: > inventory_items.id]
  location_id         bigint [ref: > locations.id, note: "Bodega ERP"]

  // --- Estados que SUMAN on_hand ---
  available           int    [default: 0, note: "Disponible para venta"]
  committed           int    [default: 0, note: "Comprometido en órdenes no despachadas"]
  reserved            int    [default: 0, note: "Reservado (drafts, checkouts u otras apps)"]
  damaged             int    [default: 0, note: "Dañado, no vendible"]
  safety_stock        int    [default: 0, note: "Buffer de seguridad"]
  quality_control     int    [default: 0, note: "En inspección"]
  on_hand             int    [note: "= available+committed+reserved+damaged+safety_stock+quality_control"]

  // --- Estado independiente, NO forma parte de on_hand ---
  incoming            int    [default: 0, note: "En tránsito / transferencias entrantes"]

  updated_at          timestamptz

  indexes {
    (inventory_item_id, location_id) [pk]
    (tenant_id, location_id)
  }
  note: "Stock REAL (fuente de verdad ERP) por bodega, con los 8 estados de Shopify. committed = suma de lo comprometido en todas las tiendas."
}

Table shop_inventory_levels {
  tenant_id           bigint [ref: > tenants.id]
  shop_id             bigint [ref: > shops.id]
  inventory_item_id   bigint [ref: > inventory_items.id, note: "Ítem ERP"]
  shop_location_id    bigint [ref: > shop_locations.id, note: "Location de la tienda (y por ella la bodega ERP)"]
  shopify_gid         varchar(255) [null, note: "gid://shopify/InventoryLevel/..."]
  available           int    [default: 0]
  committed           int    [default: 0]
  reserved            int    [default: 0]
  damaged             int    [default: 0]
  safety_stock        int    [default: 0]
  quality_control     int    [default: 0]
  on_hand             int    [default: 0]
  incoming            int    [default: 0]
  target_available    int    [null, note: "Lo que el ERP quiere publicar según shop_locations.stock_sync_mode"]
  drift               int    [null, note: "available - target_available (≠ 0 => pendiente de push o desfase)"]
  shopify_updated_at  timestamptz [null]
  synced_at           timestamptz [null]

  indexes {
    (shop_id, inventory_item_id, shop_location_id) [pk]
    (tenant_id, inventory_item_id)
    (shop_id, drift)
  }
  note: "Espejo de lo que cada tienda Shopify tiene publicado (InventoryLevel por tienda). Sirve para conciliar contra inventory_levels y detectar desfases."
}

Table inventory_adjustments {
  id                    bigint       [pk, increment]
  tenant_id             bigint       [ref: > tenants.id]
  shop_id               bigint       [null, ref: > shops.id]
  inventory_item_id     bigint       [ref: > inventory_items.id]
  location_id           bigint       [ref: > locations.id]
  shopify_group_gid     varchar(255) [null, note: "gid://shopify/InventoryAdjustmentGroup/..."]
  quantity_name         varchar(30)  [note: "available | on_hand | damaged | reserved | safety_stock | quality_control | incoming | committed"]
  delta                 int          [note: "Cambio aplicado (+/-)"]
  quantity_after        int          [null]
  reason                varchar(40)  [note: "correction | cycle_count_available | damaged | received | restock | shrinkage | safety_stock | quality_control | movement_created | other..."]
  reference_document_uri varchar(500) [null, note: "Ej: gid://erp/PurchaseOrder/123 (trazabilidad al documento origen)"]
  source                varchar(20)  [note: "SHOPIFY | ERP"]
  user_id               bigint       [null, ref: > users.id]
  created_at            timestamptz

  indexes {
    (tenant_id, inventory_item_id, location_id, created_at)
    (tenant_id, reference_document_uri)
  }
  note: "Kardex: historial de movimientos. Stock editable desde ERP Y desde Shopify: se sincroniza por DELTAS (inventoryAdjustQuantities), nunca sobrescribiendo el total, para no perder ventas concurrentes. Al escribir totales usar compare-and-set."
}

// ------------------------------------------------------------
// 6. CLIENTES DE LAS TIENDAS
// ------------------------------------------------------------

Table customer_profiles {
  id                  bigint        [pk, increment]
  tenant_id           bigint        [ref: > tenants.id]
  primary_email       varchar(255)  [null, note: "Clave principal de unificación (normalizada a minúsculas)"]
  primary_phone       varchar(50)   [null, note: "E.164"]
  first_name          varchar(100)  [null]
  last_name           varchar(100)  [null]
  tax_id              varchar(50)   [null, note: "RUT / NIF / VAT para facturación ERP"]
  merge_method        varchar(20)   [default: "auto_email", note: "auto_email | auto_phone | manual"]
  lifetime_orders     bigint        [default: 0, note: "Suma de todas las tiendas"]
  lifetime_spent      decimal(18,4) [default: 0, note: "En tenants.reporting_currency"]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (tenant_id, primary_email)
    (tenant_id, primary_phone)
    (tenant_id, tax_id)
  }
  note: "Ficha ÚNICA de la persona/empresa en el ERP. La misma persona que compra en 3 tiendas son 3 Customers en Shopify, pero 1 perfil aquí."
}

Table customers {
  id                  bigint        [pk, increment, note: "ID interno del cliente en el ERP"]
  tenant_id           bigint        [ref: > tenants.id]
  customer_profile_id bigint        [null, ref: > customer_profiles.id, note: "Perfil unificado multi-tienda"]
  shop_id             bigint        [null, ref: > shops.id, note: "Tienda donde existe este Customer (NULL = cliente manual del ERP)"]
  shopify_gid         varchar(255)  [null, note: "gid://shopify/Customer/..."]
  shopify_legacy_id   bigint        [null]
  email               varchar(255)  [null, note: "Customer.defaultEmailAddress.emailAddress"]
  phone               varchar(50)   [null, note: "Customer.defaultPhoneNumber.phoneNumber (E.164)"]
  first_name          varchar(100)  [null]
  last_name           varchar(100)  [null]
  display_name        varchar(255)
  locale              varchar(20)   [null]
  state               varchar(20)   [note: "ENABLED | DISABLED | INVITED | DECLINED"]
  verified_email      boolean       [default: false]
  tax_exempt          boolean       [default: false]
  tax_exemptions      "text[]"      [null, note: "Customer.taxExemptions (ej: CA_STATUS_CARD_EXEMPTION)"]
  tags                "text[]"      [null]
  note                text          [null]
  number_of_orders    bigint        [default: 0, note: "Customer.numberOfOrders (antes orders_count)"]
  amount_spent        decimal(18,4) [default: 0, note: "Customer.amountSpent.amount"]
  amount_spent_currency varchar(3)
  default_address_id  bigint        [null, note: "FK lógica a customer_addresses.id"]
  shopify_updated_at  timestamptz   [null]
  deleted_at          timestamptz   [null]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (shop_id, shopify_gid) [unique]
    (tenant_id, shop_id)
    (tenant_id, email)
    (tenant_id, customer_profile_id)
    (tenant_id, deleted_at)
  }
  note: "Customer de UNA tienda (espejo de Shopify). Se agrupan por customer_profile_id."
}

Table customer_email_marketing_consent {
  customer_id            bigint      [pk, ref: - customers.id]
  tenant_id              bigint      [ref: > tenants.id]
  marketing_state        varchar(20) [note: "SUBSCRIBED | NOT_SUBSCRIBED | PENDING | UNSUBSCRIBED | REDACTED | INVALID"]
  marketing_opt_in_level varchar(20) [null, note: "SINGLE_OPT_IN | CONFIRMED_OPT_IN | UNKNOWN"]
  consent_updated_at     timestamptz [null]

  note: "Customer.defaultEmailAddress.marketingState (reemplaza a accepts_marketing)."
}

Table customer_sms_marketing_consent {
  customer_id              bigint      [pk, ref: - customers.id]
  tenant_id                bigint      [ref: > tenants.id]
  marketing_state          varchar(20) [note: "SUBSCRIBED | NOT_SUBSCRIBED | PENDING | UNSUBSCRIBED | REDACTED"]
  marketing_opt_in_level   varchar(20) [null, note: "SINGLE_OPT_IN | CONFIRMED_OPT_IN | UNKNOWN"]
  consent_collected_from   varchar(20) [null, note: "SHOPIFY | OTHER"]
  consent_updated_at       timestamptz [null]

  note: "Customer.defaultPhoneNumber.marketingState."
}

Table customer_addresses {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id, note: "Desnormalizado para RLS"]
  customer_id     bigint       [ref: > customers.id]
  shopify_gid     varchar(255) [null, note: "gid://shopify/MailingAddress/..."]
  first_name      varchar(100) [null]
  last_name       varchar(100) [null]
  company         varchar(255) [null]
  address1        varchar(255) [null]
  address2        varchar(255) [null]
  city            varchar(100) [null]
  province        varchar(100) [null]
  province_code   varchar(10)  [null]
  country         varchar(100) [null]
  country_code    varchar(2)   [null, note: "countryCodeV2"]
  zip             varchar(20)  [null]
  phone           varchar(50)  [null]

  indexes {
    (tenant_id, customer_id)
  }
  note: "Customer.addressesV2. La dirección por defecto se marca en customers.default_address_id."
}

// ------------------------------------------------------------
// 7. ÓRDENES, LÍNEAS, IMPUESTOS, DESCUENTOS Y ENVÍOS
// ------------------------------------------------------------

Table orders {
  id                        bigint        [pk, increment, note: "ID interno propio del ERP"]
  tenant_id                 bigint        [ref: > tenants.id]
  shop_id                   bigint        [null, ref: > shops.id, note: "Tienda de origen (NULL si es venta manual del ERP)"]
  shopify_gid               varchar(255)  [null, note: "gid://shopify/Order/..."]
  shopify_legacy_id         bigint        [null]
  order_number              int           [note: "Order.number: 1001, 1002..."]
  name                      varchar(50)   [note: "Order.name: '#1001'"]
  confirmation_number       varchar(50)   [null, note: "Order.confirmationNumber"]
  customer_id               bigint        [null, ref: > customers.id]
  email                     varchar(255)  [null]
  phone                     varchar(50)   [null]
  customer_locale           varchar(20)   [null]
  po_number                 varchar(100)  [null]

  // --- Estados (GraphQL display*) ---
  display_financial_status  varchar(30)   [null, note: "PENDING | AUTHORIZED | PARTIALLY_PAID | PAID | PARTIALLY_REFUNDED | REFUNDED | VOIDED | EXPIRED"]
  display_fulfillment_status varchar(30)  [note: "UNFULFILLED | PARTIALLY_FULFILLED | FULFILLED | RESTOCKED | PENDING_FULFILLMENT | OPEN | IN_PROGRESS | ON_HOLD | SCHEDULED | REQUEST_DECLINED"]
  return_status             varchar(30)   [default: "NO_RETURN", note: "NO_RETURN | RETURN_REQUESTED | IN_PROGRESS | INSPECTION_COMPLETE | RETURNED | RETURN_FAILED"]
  cancel_reason             varchar(20)   [null, note: "CUSTOMER | DECLINED | FRAUD | INVENTORY | STAFF | OTHER"]
  cancelled_at              timestamptz   [null]
  closed_at                 timestamptz   [null]
  edited                    boolean       [default: false, note: "Order.edited (hubo Order Edit)"]

  // --- Monedas ---
  currency_code             varchar(3)    [note: "Moneda de la tienda (shopMoney)"]
  presentment_currency_code varchar(3)    [note: "Moneda en que pagó el comprador (presentmentMoney)"]
  taxes_included            boolean       [default: false, note: "Precios incluyen impuestos (clave para contabilidad)"]
  tax_exempt                boolean       [default: false]
  duties_included           boolean       [default: false]

  // --- Totales originales (al crear la orden) - shopMoney ---
  subtotal_price            decimal(18,4) [note: "subtotalPriceSet"]
  total_discounts           decimal(18,4) [note: "totalDiscountsSet"]
  total_shipping_price      decimal(18,4) [note: "totalShippingPriceSet"]
  total_tax                 decimal(18,4) [note: "totalTaxSet"]
  total_duties              decimal(18,4) [null, note: "originalTotalDutiesSet"]
  total_price               decimal(18,4) [note: "totalPriceSet"]
  total_price_presentment   decimal(18,4) [note: "totalPriceSet.presentmentMoney"]

  // --- Totales actuales (tras ediciones, reembolsos y devoluciones) - shopMoney ---
  current_subtotal_price    decimal(18,4) [note: "currentSubtotalPriceSet"]
  current_total_discounts   decimal(18,4) [note: "currentTotalDiscountsSet"]
  current_total_tax         decimal(18,4) [note: "currentTotalTaxSet"]
  current_total_duties      decimal(18,4) [null, note: "currentTotalDutiesSet"]
  current_total_price       decimal(18,4) [note: "currentTotalPriceSet"]
  current_total_price_presentment decimal(18,4)
  total_refunded            decimal(18,4) [default: 0, note: "totalRefundedSet"]
  total_outstanding         decimal(18,4) [default: 0, note: "totalOutstandingSet (saldo por cobrar)"]
  total_received            decimal(18,4) [default: 0, note: "totalReceivedSet"]

  // --- Reporte consolidado multi-tienda ---
  reporting_currency        varchar(3)    [null, note: "tenants.reporting_currency al momento de procesar"]
  exchange_rate_to_reporting decimal(18,8) [null, note: "Snapshot: 1 currency_code = X reporting_currency (de exchange_rates)"]
  current_total_price_reporting decimal(18,4) [null, note: "current_total_price * exchange_rate_to_reporting"]

  total_weight              bigint        [null, note: "Order.totalWeight en gramos"]
  note                      text          [null]
  tags                      "text[]"      [null]
  custom_attributes         jsonb         [null, note: "Order.customAttributes [{key, value}]"]
  source_name               varchar(50)   [null, note: "web | pos | shopify_draft_order | iphone | android | <app_id> | erp_manual"]
  source_identifier         varchar(255)  [null]
  app_name                  varchar(255)  [null, note: "Order.app.name (canal/app que creó la orden)"]
  test                      boolean       [default: false]
  confirmed                 boolean       [default: true]
  sync_status               varchar(20)   [default: "synced", note: "synced | pending_push | error"]
  shopify_updated_at        timestamptz   [null, note: "Evita que webhooks tardíos pisen ediciones locales"]
  synced_at                 timestamptz   [null]
  version                   int           [default: 1, note: "Optimistic concurrency lock"]
  deleted_at                timestamptz   [null, note: "Solo para webhook orders/delete. Las canceladas usan cancelled_at"]
  processed_at              timestamptz
  created_at                timestamptz
  updated_at                timestamptz

  indexes {
    (shop_id, shopify_gid) [unique]
    (shop_id, order_number) [unique]
    (tenant_id, shop_id, processed_at)
    (tenant_id, display_financial_status)
    (tenant_id, display_fulfillment_status)
    (tenant_id, customer_id)
    (tenant_id, deleted_at)
  }
  note: "Orden de venta. Hub central para facturación, contabilidad e inventario."
}

Table order_addresses {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id]
  order_id        bigint       [ref: > orders.id]
  type            varchar(20)  [note: "billing | shipping"]
  first_name      varchar(100) [null]
  last_name       varchar(100) [null]
  company         varchar(255) [null]
  address1        varchar(255) [null]
  address2        varchar(255) [null]
  city            varchar(100) [null]
  province        varchar(100) [null]
  province_code   varchar(10)  [null]
  country         varchar(100) [null]
  country_code    varchar(2)   [null, note: "countryCodeV2"]
  zip             varchar(20)  [null]
  phone           varchar(50)  [null]
  latitude        decimal(10,7) [null]
  longitude       decimal(10,7) [null]

  indexes {
    (order_id, type) [unique]
    (tenant_id, order_id)
  }
  note: "Snapshot inmutable de Order.billingAddress / Order.shippingAddress."
}

Table line_items {
  id                        bigint        [pk, increment]
  tenant_id                 bigint        [ref: > tenants.id, note: "Desnormalizado para RLS y reportes"]
  order_id                  bigint        [ref: > orders.id]
  shopify_gid               varchar(255)  [null, note: "gid://shopify/LineItem/..."]
  variant_id                bigint        [null, ref: > product_variants.id, note: "NULL si es custom item o la variante fue borrada"]
  product_id                bigint        [null, ref: > products.id]
  title                     varchar(255)  [note: "Nombre del producto al momento de compra"]
  variant_title             varchar(255)  [null]
  sku                       varchar(255)  [null]
  vendor                    varchar(255)  [null]

  // --- Cantidades (GraphQL) ---
  quantity                  int           [note: "Cantidad original"]
  current_quantity          int           [note: "Tras ediciones y reembolsos"]
  unfulfilled_quantity      int
  refundable_quantity       int
  non_fulfillable_quantity  int           [default: 0]

  // --- Precios (shopMoney + presentmentMoney) ---
  original_unit_price       decimal(18,4) [note: "originalUnitPriceSet"]
  original_unit_price_presentment decimal(18,4)
  discounted_unit_price     decimal(18,4) [note: "discountedUnitPriceAfterAllDiscountsSet"]
  discounted_unit_price_presentment decimal(18,4)
  total_discount            decimal(18,4) [default: 0, note: "totalDiscountSet"]
  total_discount_presentment decimal(18,4) [default: 0]

  taxable                   boolean
  requires_shipping         boolean
  is_gift_card              boolean       [default: false]
  selling_plan_name         varchar(255)  [null, note: "LineItem.sellingPlan (suscripciones)"]
  line_item_group_gid       varchar(255)  [null, note: "LineItem.lineItemGroup (componentes de un bundle)"]
  custom_attributes         jsonb         [null, note: "Propiedades de la línea [{key, value}]"]

  indexes {
    (tenant_id, order_id)
    (tenant_id, sku)
    (tenant_id, variant_id)
  }
  note: "Líneas de la orden (Order.lineItems)."
}

Table shipping_lines {
  id                      bigint        [pk, increment]
  tenant_id               bigint        [ref: > tenants.id]
  order_id                bigint        [ref: > orders.id]
  shopify_gid             varchar(255)  [null]
  title                   varchar(255)  [note: "'Envío Express', 'DHL Standard'"]
  code                    varchar(255)  [null]
  source                  varchar(100)  [null, note: "shopify | <carrier service>"]
  carrier_identifier      varchar(255)  [null]
  original_price          decimal(18,4) [note: "originalPriceSet"]
  original_price_presentment decimal(18,4)
  discounted_price        decimal(18,4) [note: "discountedPriceSet"]
  discounted_price_presentment decimal(18,4)
  is_removed              boolean       [default: false, note: "ShippingLine.isRemoved (por order edit)"]

  indexes {
    (tenant_id, order_id)
  }
  note: "Order.shippingLines."
}

Table tax_lines {
  id              bigint        [pk, increment]
  tenant_id       bigint        [ref: > tenants.id]
  order_id        bigint        [ref: > orders.id, note: "Siempre presente para consultas rápidas"]
  parent_type     varchar(20)   [note: "LINE_ITEM | SHIPPING_LINE"]
  parent_id       bigint        [note: "line_items.id o shipping_lines.id (FK polimórfica)"]
  title           varchar(255)  [note: "'IVA 19%', 'State Tax', 'VAT 21%'"]
  price           decimal(18,4) [note: "priceSet.shopMoney"]
  price_presentment decimal(18,4)
  rate            decimal(9,6)  [null, note: "0.190000"]
  rate_percentage decimal(7,4)  [null, note: "19.0000"]
  channel_liable  boolean       [default: false, note: "El canal/marketplace retiene el impuesto"]

  indexes {
    (tenant_id, order_id)
    (parent_type, parent_id)
  }
  note: "Impuestos POR LÍNEA (LineItem.taxLines y ShippingLine.taxLines). El total por orden se obtiene agregando."
}

Table discount_applications {
  id                bigint        [pk, increment]
  tenant_id         bigint        [ref: > tenants.id]
  order_id          bigint        [ref: > orders.id]
  application_index int           [note: "DiscountApplication.index (orden de aplicación)"]
  type              varchar(20)   [note: "DISCOUNT_CODE | AUTOMATIC | MANUAL | SCRIPT"]
  code              varchar(255)  [null, note: "Solo DISCOUNT_CODE"]
  title             varchar(255)  [null, note: "AUTOMATIC / MANUAL / SCRIPT"]
  description       varchar(255)  [null]
  allocation_method varchar(10)   [note: "ACROSS | EACH | ONE"]
  target_selection  varchar(10)   [note: "ALL | ENTITLED | EXPLICIT"]
  target_type       varchar(20)   [note: "LINE_ITEM | SHIPPING_LINE"]
  value_type        varchar(20)   [note: "PERCENTAGE | FIXED_AMOUNT (PricingPercentageValue | MoneyV2)"]
  value             decimal(18,4) [note: "Porcentaje (15.0) o monto"]
  value_currency    varchar(3)    [null, note: "Solo si FIXED_AMOUNT"]
  discount_id       bigint        [null, ref: > discounts.id, note: "Descuento de origen si es conocido"]

  indexes {
    (order_id, application_index) [unique]
    (tenant_id, code)
  }
  note: "Order.discountApplications: qué descuentos se aplicaron a la orden."
}

Table discount_allocations {
  id                       bigint        [pk, increment]
  tenant_id                bigint        [ref: > tenants.id]
  order_id                 bigint        [ref: > orders.id]
  discount_application_id  bigint        [ref: > discount_applications.id]
  parent_type              varchar(20)   [note: "LINE_ITEM | SHIPPING_LINE"]
  parent_id                bigint        [note: "line_items.id o shipping_lines.id"]
  amount                   decimal(18,4) [note: "allocatedAmountSet.shopMoney"]
  amount_presentment       decimal(18,4)

  indexes {
    (tenant_id, order_id)
    (parent_type, parent_id)
  }
  note: "LineItem.discountAllocations / ShippingLine.discountAllocations: cuánto descuento cayó en cada línea."
}

Table transactions {
  id                    bigint        [pk, increment]
  tenant_id             bigint        [ref: > tenants.id]
  order_id              bigint        [ref: > orders.id]
  shopify_gid           varchar(255)  [null, note: "gid://shopify/OrderTransaction/..."]
  parent_transaction_id bigint        [null, ref: > transactions.id, note: "Captura/void/refund apuntan a su autorización"]
  refund_id             bigint        [null, ref: > refunds.id]
  kind                  varchar(30)   [note: "AUTHORIZATION | CAPTURE | SALE | VOID | REFUND | CHANGE | EMV_AUTHORIZATION | SUGGESTED_REFUND"]
  status                varchar(20)   [note: "AWAITING_RESPONSE | PENDING | SUCCESS | FAILURE | ERROR | UNKNOWN"]
  amount                decimal(18,4) [note: "amountSet.shopMoney"]
  amount_presentment    decimal(18,4)
  currency_code         varchar(3)    [note: "Moneda presentment de la transacción"]
  gateway               varchar(100)  [note: "shopify_payments | paypal | manual | etc"]
  formatted_gateway     varchar(255)  [null]
  payment_method_name   varchar(100)  [null, note: "paymentDetails (tarjeta, wallet...)"]
  authorization_code    varchar(255)  [null]
  authorization_expires_at timestamptz [null]
  error_code            varchar(50)   [null]
  fees_total            decimal(18,4) [null, note: "Suma de OrderTransaction.fees (Shopify Payments)"]
  test                  boolean       [default: false]
  processed_at          timestamptz
  created_at            timestamptz

  indexes {
    (tenant_id, order_id)
    (tenant_id, status)
    (order_id, shopify_gid) [unique]
  }
  note: "Order.transactions: pagos vinculados a la orden."
}

Table refunds {
  id                      bigint        [pk, increment]
  tenant_id               bigint        [ref: > tenants.id]
  order_id                bigint        [ref: > orders.id]
  return_id               bigint        [null, ref: > returns.id, note: "Si el reembolso viene de una devolución"]
  shopify_gid             varchar(255)  [null, note: "gid://shopify/Refund/..."]
  note                    text          [null]
  total_refunded          decimal(18,4) [note: "totalRefundedSet.shopMoney"]
  total_refunded_presentment decimal(18,4)
  created_at              timestamptz
  processed_at            timestamptz   [null]

  indexes {
    (tenant_id, order_id)
  }
  note: "Order.refunds. El restock se define por línea (refund_line_items.restock_type)."
}

Table refund_line_items {
  id              bigint        [pk, increment]
  tenant_id       bigint        [ref: > tenants.id]
  refund_id       bigint        [ref: > refunds.id]
  line_item_id    bigint        [ref: > line_items.id]
  quantity        int
  restock_type    varchar(20)   [note: "NO_RESTOCK | CANCEL | RETURN | LEGACY_RESTOCK"]
  restocked       boolean       [default: false]
  location_id     bigint        [null, ref: > locations.id]
  subtotal        decimal(18,4) [note: "subtotalSet"]
  total_tax       decimal(18,4) [note: "totalTaxSet"]

  indexes {
    (tenant_id, refund_id)
  }
}

Table refund_shipping_lines {
  id              bigint        [pk, increment]
  tenant_id       bigint        [ref: > tenants.id]
  refund_id       bigint        [ref: > refunds.id]
  shipping_line_id bigint       [ref: > shipping_lines.id]
  amount          decimal(18,4) [note: "subtotalAmountSet"]
  tax_amount      decimal(18,4) [default: 0]
}

Table returns {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id]
  order_id        bigint       [ref: > orders.id]
  shopify_gid     varchar(255) [null, note: "gid://shopify/Return/..."]
  name            varchar(50)  [note: "Ej: '#1001-R1'"]
  status          varchar(20)  [note: "REQUESTED | OPEN | CLOSED | DECLINED | CANCELED"]
  decline_reason  varchar(50)  [null]
  created_at      timestamptz
  closed_at       timestamptz  [null]

  indexes {
    (tenant_id, order_id)
    (tenant_id, status)
  }
  note: "Order.returns (devoluciones). El reembolso asociado queda en refunds.return_id."
}

Table return_line_items {
  id                            bigint       [pk, increment]
  tenant_id                     bigint       [ref: > tenants.id]
  return_id                     bigint       [ref: > returns.id]
  fulfillment_line_item_id      bigint       [null, ref: > fulfillment_line_items.id]
  line_item_id                  bigint       [ref: > line_items.id]
  shopify_gid                   varchar(255) [null]
  quantity                      int
  refundable_quantity           int
  refunded_quantity             int          [default: 0]
  return_reason                 varchar(50)  [note: "Motivo (enum o returnReasonDefinition según versión de la API)"]
  customer_note                 text         [null]

  indexes {
    (tenant_id, return_id)
  }
}

// ------------------------------------------------------------
// 8. FULFILLMENT Y LOGÍSTICA
// ------------------------------------------------------------

Table fulfillment_orders {
  id                  bigint       [pk, increment]
  tenant_id           bigint       [ref: > tenants.id]
  order_id            bigint       [ref: > orders.id]
  assigned_location_id bigint      [null, ref: > locations.id, note: "Bodega ERP, resuelta desde FulfillmentOrder.assignedLocation vía shop_locations"]
  shopify_gid         varchar(255) [null, note: "gid://shopify/FulfillmentOrder/..."]
  status              varchar(20)  [note: "OPEN | IN_PROGRESS | SCHEDULED | ON_HOLD | INCOMPLETE | CANCELLED | CLOSED"]
  request_status      varchar(30)  [note: "UNSUBMITTED | SUBMITTED | ACCEPTED | REJECTED | CANCELLATION_REQUESTED | CANCELLATION_ACCEPTED | CANCELLATION_REJECTED | CLOSED"]
  delivery_method_type varchar(20) [null, note: "SHIPPING | LOCAL | PICK_UP | PICKUP_POINT | RETAIL | NONE"]
  fulfillment_service_handle varchar(100) [null]
  fulfill_at          timestamptz  [null, note: "Fecha programada (pre-orders / suscripciones)"]
  fulfill_by          timestamptz  [null]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (tenant_id, order_id)
    (tenant_id, status)
    (tenant_id, assigned_location_id, status)
  }
  note: "Order.fulfillmentOrders: qué preparar y desde qué ubicación."
}

Table fulfillment_order_holds {
  id                    bigint       [pk, increment]
  tenant_id             bigint       [ref: > tenants.id]
  fulfillment_order_id  bigint       [ref: > fulfillment_orders.id]
  reason                varchar(50)  [note: "AWAITING_PAYMENT | HIGH_RISK_OF_FRAUD | INCORRECT_ADDRESS | INVENTORY_OUT_OF_STOCK | UNKNOWN_DELIVERY_DATE | AWAITING_RETURN_ITEMS | OTHER | ..."]
  reason_notes          text         [null]
  held_by_app           varchar(255) [null]
  created_at            timestamptz
  released_at           timestamptz  [null]

  indexes {
    (tenant_id, fulfillment_order_id)
  }
  note: "FulfillmentOrder.fulfillmentHolds (pedidos retenidos)."
}

Table fulfillment_order_line_items {
  id                      bigint       [pk, increment]
  tenant_id               bigint       [ref: > tenants.id]
  fulfillment_order_id    bigint       [ref: > fulfillment_orders.id]
  line_item_id            bigint       [ref: > line_items.id]
  inventory_item_id       bigint       [null, ref: > inventory_items.id]
  shopify_gid             varchar(255) [null, note: "gid://shopify/FulfillmentOrderLineItem/..."]
  total_quantity          int
  remaining_quantity      int

  indexes {
    (tenant_id, fulfillment_order_id)
  }
}

Table fulfillments {
  id                  bigint       [pk, increment]
  tenant_id           bigint       [ref: > tenants.id]
  order_id            bigint       [ref: > orders.id]
  location_id         bigint       [null, ref: > locations.id]
  shopify_gid         varchar(255) [null, note: "gid://shopify/Fulfillment/..."]
  name                varchar(50)  [null, note: "Ej: '#1001-F1'"]
  status              varchar(20)  [note: "SUCCESS | CANCELLED | ERROR | FAILURE"]
  display_status      varchar(30)  [null, note: "LABEL_PRINTED | LABEL_PURCHASED | CONFIRMED | IN_TRANSIT | OUT_FOR_DELIVERY | ATTEMPTED_DELIVERY | DELIVERED | READY_FOR_PICKUP | PICKED_UP | FAILURE | CANCELED | ..."]
  estimated_delivery_at timestamptz [null]
  in_transit_at       timestamptz  [null]
  delivered_at        timestamptz  [null]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (tenant_id, order_id)
    (tenant_id, display_status)
  }
  note: "Envío físico realizado (Order.fulfillments)."
}

Table fulfillment_tracking {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id]
  fulfillment_id  bigint       [ref: > fulfillments.id]
  company         varchar(255) [null]
  number          varchar(255) [null]
  url             varchar(1000) [null]

  indexes {
    (tenant_id, number)
  }
  note: "Fulfillment.trackingInfo: un envío puede tener varios números de seguimiento."
}

Table fulfillment_line_items {
  id                            bigint       [pk, increment]
  tenant_id                     bigint       [ref: > tenants.id]
  fulfillment_id                bigint       [ref: > fulfillments.id]
  fulfillment_order_line_item_id bigint      [null, ref: > fulfillment_order_line_items.id]
  line_item_id                  bigint       [ref: > line_items.id]
  shopify_gid                   varchar(255) [null, note: "gid://shopify/FulfillmentLineItem/..."]
  quantity                      int

  indexes {
    (tenant_id, fulfillment_id)
  }
  note: "Fulfillment.fulfillmentLineItems."
}

// ------------------------------------------------------------
// 9. COLECCIONES Y DESCUENTOS
// ------------------------------------------------------------

Table collections {
  id                  bigint       [pk, increment]
  tenant_id           bigint       [ref: > tenants.id]
  shop_id             bigint       [null, ref: > shops.id]
  shopify_gid         varchar(255) [null, note: "gid://shopify/Collection/..."]
  shopify_legacy_id   bigint       [null]
  title               varchar(255)
  handle              varchar(255)
  description_html    text         [null, note: "Collection.descriptionHtml"]
  image_media_id      bigint       [null, ref: > media.id]
  sort_order          varchar(30)  [note: "MANUAL | BEST_SELLING | ALPHA_ASC | ALPHA_DESC | PRICE_ASC | PRICE_DESC | CREATED | CREATED_DESC"]
  seo_title           varchar(255) [null]
  seo_description     text         [null]
  template_suffix     varchar(100) [null]
  collection_type     varchar(10)  [note: "custom | smart (smart = tiene ruleSet)"]
  rules_applied_disjunctively boolean [null, note: "ruleSet.appliedDisjunctively: true = OR entre reglas, false = AND"]
  published_at        timestamptz  [null]
  shopify_updated_at  timestamptz  [null]
  deleted_at          timestamptz  [null]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (shop_id, shopify_gid) [unique]
    (shop_id, handle)
    (tenant_id, shop_id)
  }
  note: "Collection (GraphQL unifica custom y smart en un solo tipo)."
}

Table collection_products {
  tenant_id       bigint [ref: > tenants.id]
  collection_id   bigint [ref: > collections.id]
  product_id      bigint [ref: > products.id]
  position        int    [null, note: "Solo relevante con sort_order = MANUAL"]

  indexes {
    (collection_id, product_id) [pk]
    (tenant_id, product_id)
  }
}

Table collection_rules {
  id                    bigint       [pk, increment]
  tenant_id             bigint       [ref: > tenants.id]
  collection_id         bigint       [ref: > collections.id]
  column                varchar(40)  [note: "TITLE | TYPE | VENDOR | TAG | VARIANT_TITLE | VARIANT_PRICE | VARIANT_COMPARE_AT_PRICE | VARIANT_WEIGHT | VARIANT_INVENTORY | IS_PRICE_REDUCED | PRODUCT_CATEGORY_ID | PRODUCT_CATEGORY_ID_WITH_DESCENDANTS | PRODUCT_METAFIELD_DEFINITION | VARIANT_METAFIELD_DEFINITION"]
  relation              varchar(20)  [note: "EQUALS | NOT_EQUALS | GREATER_THAN | LESS_THAN | STARTS_WITH | ENDS_WITH | CONTAINS | NOT_CONTAINS | IS_SET | IS_NOT_SET"]
  condition             varchar(255)
  condition_object_gid  varchar(255) [null, note: "MetafieldDefinition o TaxonomyCategory referenciada por la regla"]

  indexes {
    (tenant_id, collection_id)
  }
  note: "Collection.ruleSet.rules (colecciones automáticas)."
}

Table discounts {
  id                        bigint        [pk, increment]
  tenant_id                 bigint        [ref: > tenants.id]
  shop_id                   bigint        [null, ref: > shops.id]
  shopify_gid               varchar(255)  [null, note: "gid://shopify/DiscountCodeNode/... o DiscountAutomaticNode/..."]
  method                    varchar(10)   [note: "CODE | AUTOMATIC"]
  discount_type             varchar(20)   [note: "BASIC | BXGY | FREE_SHIPPING | APP"]
  title                     varchar(255)
  status                    varchar(20)   [note: "ACTIVE | SCHEDULED | EXPIRED"]
  discount_classes          "text[]"      [note: "PRODUCT | ORDER | SHIPPING (discountClasses, 2025-04+)"]
  combines_with_order       boolean       [default: false, note: "combinesWith.orderDiscounts"]
  combines_with_product     boolean       [default: false, note: "combinesWith.productDiscounts"]
  combines_with_shipping    boolean       [default: false, note: "combinesWith.shippingDiscounts"]
  starts_at                 timestamptz
  ends_at                   timestamptz   [null]
  usage_limit               int           [null, note: "Solo CODE. NULL = ilimitado"]
  applies_once_per_customer boolean       [default: false]
  async_usage_count         int           [default: 0, note: "asyncUsageCount"]
  customer_gets             jsonb         [null, note: "customerGets: valor (% / monto) y a qué productos/colecciones aplica"]
  customer_buys             jsonb         [null, note: "customerBuys (solo BXGY)"]
  minimum_requirement_type  varchar(20)   [null, note: "NONE | QUANTITY | SUBTOTAL"]
  minimum_requirement_value decimal(18,4) [null]
  eligibility               jsonb         [null, note: "context / customerSelection: todos, segmentos o clientes específicos"]
  app_function_id           varchar(255)  [null, note: "Shopify Function (solo discount_type = APP)"]
  shopify_updated_at        timestamptz   [null]
  created_at                timestamptz
  updated_at                timestamptz

  indexes {
    (shop_id, shopify_gid) [unique]
    (tenant_id, shop_id, status)
  }
  note: "DiscountNode (reemplaza al obsoleto PriceRule)."
}

Table discount_codes {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id]
  shop_id         bigint       [null, ref: > shops.id]
  discount_id     bigint       [ref: > discounts.id]
  shopify_gid     varchar(255) [null, note: "gid://shopify/DiscountRedeemCode/..."]
  code            varchar(255)
  usage_count     int          [default: 0]
  created_at      timestamptz

  indexes {
    (shop_id, code) [unique, note: "Únicos por tienda, no globales"]
    (tenant_id, discount_id)
  }
  note: "DiscountCodeNode.codeDiscount.codes."
}

// ------------------------------------------------------------
// 10. METAFIELDS (Campos Personalizados por Tenant)
// ------------------------------------------------------------

Table metafields {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id]
  shop_id         bigint       [null, ref: > shops.id, note: "Los metafields existen por tienda en Shopify"]
  shopify_gid     varchar(255) [null, note: "gid://shopify/Metafield/..."]
  owner_id        bigint       [note: "ID interno del recurso dueño (FK polimórfica)"]
  owner_resource  varchar(30)  [note: "PRODUCT | PRODUCTVARIANT | COLLECTION | CUSTOMER | ORDER | LOCATION | COMPANY | SHOP | ..."]
  namespace       varchar(255) [note: "Ej: 'custom', '$app'"]
  key             varchar(64)
  value           text
  type            varchar(50)  [note: "single_line_text_field | json | number_integer | boolean | url | metaobject_reference | list.* | etc"]
  compare_digest  varchar(255) [null, note: "Metafield.compareDigest para escrituras compare-and-set"]
  created_at      timestamptz
  updated_at      timestamptz

  indexes {
    (tenant_id, shop_id, owner_resource, owner_id, namespace, key) [unique]
  }
  note: "Campos custom por tienda y recurso."
}

// ------------------------------------------------------------
// 11. SINCRONIZACIÓN MULTI-TIENDA (Catálogo maestro <-> N tiendas)
// ------------------------------------------------------------

Table shopify_resource_links {
  id                  bigint       [pk, increment]
  tenant_id           bigint       [ref: > tenants.id]
  shop_id             bigint       [ref: > shops.id]
  resource_type       varchar(30)  [note: "PRODUCT | PRODUCT_OPTION | PRODUCT_OPTION_VALUE | PRODUCT_VARIANT | INVENTORY_ITEM | MEDIA"]
  erp_id              bigint       [note: "ID en la tabla maestra (products.id, product_variants.id, ...). FK polimórfica"]
  shopify_gid         varchar(255) [note: "GID del recurso en ESA tienda"]
  shopify_legacy_id   bigint       [null]
  remote_status       varchar(30)  [null, note: "Estado propio de Shopify si aplica (ej. MEDIA: UPLOADED | PROCESSING | READY | FAILED)"]
  remote_url          varchar(1000) [null, note: "URL del recurso en Shopify (ej. CDN de la imagen)"]
  sync_status         varchar(20)  [default: "synced", note: "synced | pending_push | pending_pull | conflict | error"]
  erp_version_synced  int          [null, note: "version de la fila ERP enviada en el último push exitoso"]
  shopify_updated_at  timestamptz  [null, note: "updatedAt de Shopify del último pull (resolución de conflictos)"]
  synced_at           timestamptz  [null]
  last_error          text         [null]
  unlinked_at         timestamptz  [null, note: "Se borró en Shopify o se despublicó de la tienda"]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (shop_id, shopify_gid) [unique, note: "Resolver webhook -> entidad ERP"]
    (shop_id, resource_type, erp_id) [unique, note: "Una entidad ERP = un recurso por tienda"]
    (tenant_id, resource_type, erp_id)
    (shop_id, sync_status)
  }
  note: "IDENTIDAD: qué GID tiene cada entidad maestra en cada tienda. Un producto en 3 tiendas = 3 filas."
}

Table product_shop_listings {
  id                    bigint       [pk, increment]
  tenant_id             bigint       [ref: > tenants.id]
  shop_id               bigint       [ref: > shops.id]
  product_id            bigint       [ref: > products.id]
  status                varchar(20)  [default: "DRAFT", note: "Estado en ESA tienda: ACTIVE | DRAFT | ARCHIVED"]
  published_online_store boolean     [default: false]
  publication_gids      "text[]"     [null, note: "Publications (canales) donde está publicado: Online Store, POS, Shop, ..."]
  published_at          timestamptz  [null]
  title_override        varchar(255) [null, note: "NULL = usa products.title"]
  description_html_override text     [null]
  handle_override       varchar(255) [null]
  seo_title_override    varchar(255) [null]
  seo_description_override text      [null]
  tags_extra            "text[]"     [null, note: "Tags adicionales solo para esta tienda"]
  template_suffix       varchar(100) [null]
  created_at            timestamptz
  updated_at            timestamptz

  indexes {
    (shop_id, product_id) [unique]
    (tenant_id, product_id)
  }
  note: "INTENCIÓN: en qué tiendas se vende cada producto maestro y con qué ajustes. Si no hay fila, el producto no existe en esa tienda."
}

Table variant_shop_listings {
  id                  bigint        [pk, increment]
  tenant_id           bigint        [ref: > tenants.id]
  shop_id             bigint        [ref: > shops.id]
  variant_id          bigint        [ref: > product_variants.id]
  price               decimal(18,4) [note: "Precio en la moneda de la tienda (shops.currency_code)"]
  compare_at_price    decimal(18,4) [null]
  price_source        varchar(20)   [default: "manual", note: "manual | fx_from_base (calculado desde base_price + exchange_rates) | rule"]
  inventory_policy    varchar(20)   [default: "DENY", note: "DENY | CONTINUE en esa tienda"]
  is_enabled          boolean       [default: true, note: "false = la variante no se publica en esta tienda"]
  created_at          timestamptz
  updated_at          timestamptz

  indexes {
    (shop_id, variant_id) [unique]
    (tenant_id, variant_id)
  }
  note: "Precio y política de venta de cada variante POR TIENDA (cada tienda puede tener otra moneda o estrategia de precios)."
}

Table shop_sync_states {
  tenant_id               bigint       [ref: > tenants.id]
  shop_id                 bigint       [ref: > shops.id]
  resource_type           varchar(30)  [note: "PRODUCTS | INVENTORY | CUSTOMERS | ORDERS | COLLECTIONS | DISCOUNTS | LOCATIONS"]
  status                  varchar(20)  [default: "idle", note: "idle | full_sync | incremental | paused | error"]
  last_full_sync_at       timestamptz  [null]
  last_incremental_at     timestamptz  [null]
  updated_at_watermark    timestamptz  [null, note: "Mayor updatedAt procesado (query: updated_at:>X)"]
  cursor                  text         [null, note: "endCursor de paginación si el sync quedó a medias"]
  current_bulk_operation_id bigint     [null, ref: > shopify_bulk_operations.id]
  last_error              text         [null]
  updated_at              timestamptz

  indexes {
    (shop_id, resource_type) [pk]
    (tenant_id, status)
  }
  note: "Dónde quedó la sincronización de cada tipo de recurso en cada tienda (reanudable)."
}

Table sync_conflicts {
  id                  bigint       [pk, increment]
  tenant_id           bigint       [ref: > tenants.id]
  shop_id             bigint       [ref: > shops.id]
  resource_type       varchar(30)  [note: "PRODUCT | PRODUCT_VARIANT | INVENTORY_ITEM | ..."]
  erp_id              bigint
  shopify_gid         varchar(255) [null]
  erp_changed_at      timestamptz  [note: "Cuándo se modificó en el ERP"]
  erp_changed_by_user_id bigint    [null, ref: > users.id]
  shopify_changed_at  timestamptz  [note: "updatedAt de Shopify"]
  winner              varchar(10)  [note: "ERP | SHOPIFY (regla: última modificación gana)"]
  erp_snapshot        jsonb        [note: "Valores del ERP antes de resolver"]
  shopify_snapshot    jsonb        [note: "Valores de Shopify antes de resolver"]
  changed_fields      "text[]"     [note: "Campos que diferían"]
  reviewed_at         timestamptz  [null, note: "Un usuario revisó el conflicto en el dashboard"]
  reviewed_by_user_id bigint       [null, ref: > users.id]
  created_at          timestamptz

  indexes {
    (tenant_id, shop_id, reviewed_at)
    (tenant_id, resource_type, erp_id)
  }
  note: "Regla LAST-WRITE-WINS: se aplica la modificación más reciente, pero se guarda lo que se sobrescribió para revisarlo. NO aplica a stock (ver inventory_adjustments: el stock se sincroniza por deltas)."
}

Table sync_jobs {
  id                  bigint       [pk, increment]
  tenant_id           bigint       [ref: > tenants.id]
  shop_id             bigint       [ref: > shops.id]
  resource_type       varchar(30)  [note: "PRODUCT | PRODUCT_VARIANT | INVENTORY | PRICE | ORDER | FULFILLMENT | ..."]
  erp_id              bigint       [null]
  operation           varchar(30)  [note: "CREATE | UPDATE | DELETE | PUBLISH | UNPUBLISH | INVENTORY_SET | FULFILL | ..."]
  payload             jsonb        [null, note: "Variables GraphQL a enviar"]
  idempotency_key     varchar(255) [unique, note: "Evita enviar dos veces la misma mutación"]
  priority            int          [default: 5, note: "1 = urgente (stock), 9 = baja (SEO)"]
  status              varchar(20)  [default: "queued", note: "queued | running | succeeded | failed | dead"]
  attempts            int          [default: 0]
  next_attempt_at     timestamptz  [null, note: "Backoff exponencial / respeto al throttle por costo de GraphQL"]
  user_errors         jsonb        [null, note: "userErrors devueltos por la mutación"]
  response            jsonb        [null]
  created_by_user_id  bigint       [null, ref: > users.id]
  created_at          timestamptz
  started_at          timestamptz  [null]
  completed_at        timestamptz  [null]

  indexes {
    (status, next_attempt_at, priority)
    (tenant_id, shop_id, status)
    (shop_id, resource_type, erp_id)
  }
  note: "Outbox ERP -> Shopify: cada cambio en el ERP genera un job por tienda afectada. Particionar o purgar por antigüedad."
}

Table exchange_rates {
  id              bigint        [pk, increment]
  base_currency   varchar(3)
  quote_currency  varchar(3)
  rate            decimal(18,8) [note: "1 base = rate quote"]
  rate_date       date
  source          varchar(50)   [note: "ECB | openexchangerates | manual | ..."]
  created_at      timestamptz

  indexes {
    (base_currency, quote_currency, rate_date) [unique]
  }
  note: "Tipos de cambio diarios (global, no por tenant) para reportes consolidados y precios fx_from_base."
}

// ------------------------------------------------------------
// 12. AUDITORÍA Y TRAZABILIDAD (AUDIT TRAIL)
// ------------------------------------------------------------

Table audit_logs {
  id              bigint       [pk, increment]
  tenant_id       bigint       [ref: > tenants.id]
  shop_id         bigint       [null, ref: > shops.id]
  user_id         bigint       [null, ref: > users.id, note: "NULL si fue webhook/cron automático"]
  source          varchar(20)  [note: "ERP_USER | SHOPIFY_WEBHOOK | SHOPIFY_SYNC | SYSTEM (quién originó el cambio)"]
  entity_type     varchar(50)  [note: "Order | Product | InventoryLevel | Discount | etc"]
  entity_id       bigint
  action          varchar(20)  [note: "INSERT | UPDATE | DELETE | SYNC | REFUND"]
  changes         jsonb        [note: "{old: {...}, new: {...}}"]
  ip_address      varchar(45)  [null]
  created_at      timestamptz

  indexes {
    (tenant_id, entity_type, entity_id)
    (tenant_id, created_at)
  }
  note: "Bitácora inmutable de auditoría. Particionar por mes (created_at)."
}
